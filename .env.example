# Copy to .env and fill in. Never commit .env.

# Postgres password used by the db container and the api connection string.
POSTGRES_PASSWORD=change-me

# Google Classroom OAuth (Google Cloud Console → APIs & Services → Credentials,
# "Web application" client with the redirect URI below authorized).
# Leave empty until you have credentials — the Classroom card shows a
# "waiting for credentials" state and the demo still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/connectors/classroom/callback

TZ=America/Sao_Paulo

# Claude Cowork workspace (host path bind-mounted read-only into the api).
# Local machine: the real dir. Homelab: the replica kept fresh by
# tools/cowork-push.sh running on the machines that edit the dir.
COWORK_DIR=~/Desktop/UFRJ
